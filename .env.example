# Supabase — copy to .env.local and fill with your project's values.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret   # server-only, never expose
SUPABASE_PROJECT_REF=your-project-ref

# AI article generation (Phase 5)
ANTHROPIC_API_KEY=sk-ant-...            # required for the weekly generation cron
ANTHROPIC_MODEL=claude-opus-4-8         # optional; defaults to claude-opus-4-8
CRON_SECRET=long-random-string          # protects /api/cron/generate-article
