# Supabase — copy to .env.local and fill with your project's values.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret   # server-only, never expose
SUPABASE_PROJECT_REF=your-project-ref

# AI article generation (Phase 5)
ANTHROPIC_API_KEY=sk-ant-...            # required for the weekly generation cron
ANTHROPIC_MODEL=claude-sonnet-4-6       # optional; defaults to claude-sonnet-4-6
CRON_SECRET=long-random-string          # protects /api/cron/generate-article

# Notifications & indexing (Phase 6)
RESEND_API_KEY=re_...                              # optional; email on new AI draft
NOTIFY_TO=info@amox.gr                             # optional; defaults to first admin email
NOTIFY_FROM=PhysioDanali <onboarding@resend.dev>  # verify a real sender domain for prod
INDEXNOW_KEY=                                      # optional; any 8-128 char hex/UUID; served at /indexnow.txt
UNSPLASH_ACCESS_KEY=                               # optional; auto cover image for AI drafts (unsplash.com/developers)
